# Authoritative structured Commons leaderboard endpoint. Required in production.
COMMONS_API_URL=
# Optional bearer token if the upstream endpoint requires one.
COMMONS_API_TOKEN=

# Optional Vercel KV / Upstash binding used to retain real historical snapshots.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Official close of the Commons experiment (ISO 8601, e.g. 2026-08-25T18:00:00Z).
# Drives the countdown clock. Without it the UI shows "CLOSE TIME TBC".
NEXT_PUBLIC_COMMONS_CLOSE_AT=
# Official start of the experiment. Optional; with CLOSE_AT it drives the
# draining time ring around the pool. Without it the ring stays full.
NEXT_PUBLIC_COMMONS_OPEN_AT=
