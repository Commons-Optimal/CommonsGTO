# The Commons account the pool is held in. Defaults to `commonstrat`.
COMMON_STRATEGY_HANDLE=

# Official close of the Commons experiment (ISO 8601, e.g. 2026-08-25T18:00:00Z).
# Drives the countdown clock. Without it the UI shows "CLOSE TIME TBC", and the
# close time is discovered from the Commons event metadata where possible.
NEXT_PUBLIC_COMMONS_CLOSE_AT=
# Official start of the experiment. Optional and no longer needed for the time
# ring, which is scaled to the final stretch (7 days, then 24 hours) rather than
# to the whole experiment window.
NEXT_PUBLIC_COMMONS_OPEN_AT=
